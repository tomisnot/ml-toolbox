{
  "kind": "ml_toolbox.opt.workspace",
  "version": 1,
  "objective_kind": "外部程序（黑盒进程）",
  "synth": "ackley",
  "ml_method": "ridge",
  "ml_cv": "3",
  "source_kind": "ML 内部数据集",
  "source_path": "",
  "source_target": "target",
  "proc": {
    "mode": 1,
    "params": "freq_mhz=7200..7500, intensity=0.3..1.0, alpha_deg=0..90, theta_deg=0..180, eps_deg=-45..45",
    "cmd": "python scripts\\freeze_blackbox.py --points {points_file} --out {out_file} --fast",
    "cwd": "C:\\path\\to\\blackbox",
    "parse": "score[:=]\\s*(-?\\d+(?:\\.\\d+)?)",
    "score_field": "C_dual",
    "maximize": true,
    "constraints": "S_ret>=0.99",
    "point_extra": "{\"fwhm_ns\": 40.0}",
    "stagger": "4",
    "timeout": "1800"
  },
  "budget": {
    "n_evals": "4",
    "stall": "0",
    "seed": "42",
    "workers": "4"
  },
  "optimizers": ["random_search"],
  "opt_cfg_owner": "random_search",
  "optimizer_cfg": {
    "random_search": {}
  }
}
