  "source_target": "target",
  "proc": {
    "mode": 1,
    "params": "freq_mhz=7321..7345, intensity=0.57..0.87, alpha_deg=1..17, theta_deg=0..20, eps_deg=-24..0",
    "cmd": "python scripts\\freeze_blackbox.py --points {points_file} --out {out_file} --fast --box 3 0.1",
