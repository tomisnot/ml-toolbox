# Python
__pycache__/
*.pyc

# 打包/安装产物（B3 补 pyproject.toml 后本仓可 pip install；
# `pip install -e .` 会在仓根落下 *.egg-info/ —— 构建产物不入库）
*.egg-info/
build/
dist/

# 实验记录（本地资产，不入库）
runs/

# AI 数据根授权清单（本机路径，不入库；模板见 docs/交付说明.md）
dataset_roots.txt

# UI 截图自查临时产物
checks/shots/

# 遗留独立仓库：不作为子模块/嵌套 git 仓库入库
old/machine_learning/

# 性能基准运行产物（本地证据，不入库）
benchmarks/perf/results/

# 本地测试运行日志（临时证据，不入库）
tests/_*.log

# GUI 运行日志（本地排错证据，不入库）
logs/

# mecha 运行期数据目录（journal + artifacts + .writer.lock 写租约；本地资产）
.ml-mecha/
.ml-mecha-hub/

# 交付形态运行期状态文件（发现用；每次启动重写）
# ⚠ **曾经还有** `.mode-state` / `.mode-request` / `.launcher.lock`（旧看门人的两模式
#   握手与单实例锁）—— 三层架构下"切写权不动进程"、编排归框架 ⇒ 三个都随
#   `launcher.py` 删掉了。活知识：`docs/旧启动器-活知识存档.md`。
.mcp-port
.ml-monitor-port
.mlweb-port
#: 控制端点（人侧那条腿）的端口文件 —— 与上面几个同族，同样每台机器重写。
.control-port
.ml-mecha-runtime.json

# 运行期生成的 dsh overlay（每次启动按实际端口重写）
runtime/

# dsh 的工作区目录：`.dsh/skills/<name>` 是指向 `skills/<name>` 的 **junction**
# （同一份文件、两个路径）。AI 实际加载的是 `.dsh/` 下那份，而**权威源入库**。
# ⚠ `git` 看不见 `.dsh/` ⇒ 改 SKILL 请改 `skills/`（junction 让两边同时变）；
#   若有人把 junction 换成真副本，`tests/test_skill_surface.py` 会当场红。
#   建/修 junction：`python checks/link_skills.py`
.dsh/

.vscode/
# Trae IDE 的文档目录（AI 编辑器的过程产物；曾入库现已不在树）
.trae/

# 统一启动器的运行期产物（pid / 日志）：每台机器各自生成，不入库。
# ⚠ 由框架 `mecha/launch.py` 写在「启动时的 cwd」下；含本机 pid。
_mecha_runtime/

dsh/bridge/
