# Python
__pycache__/
*.pyc

# 打包/安装产物（B3 补 pyproject.toml 后本仓可 pip install；
# `pip install -e .` 会在仓根落下 *.egg-info/ —— 构建产物不入库）
*.egg-info/
build/
dist/

# 实验记录（本地资产，不入库）
runs/

# UI 截图自查临时产物
checks/shots/

# 遗留独立仓库：不作为子模块/嵌套 git 仓库入库
old/machine_learning/

# 性能基准运行产物（本地证据，不入库）
benchmarks/perf/results/

# 本地测试运行日志（临时证据，不入库）
tests/_*.log

# GUI 运行日志（本地排错证据，不入库）
logs/

# mecha 运行期数据目录（journal + artifacts + .writer.lock 写租约；本地资产）
.ml-mecha/
.ml-mecha-hub/

# 交付形态运行期状态文件（看门人/发现用；每次启动重写）
.mcp-port
.ml-monitor-port
.ml-mecha-runtime.json
.mode-state
.mode-request
.launcher.lock

# AI 模式运行期生成的 dsh overlay（每次启动按实际端口重写）
runtime/

.vscode/
# Trae IDE 的文档目录（AI 编辑器的过程产物；曾入库现已不在树）
.trae/
